# Environment Variables for CacaoTrack
# Copy this file to .env and fill in your production values
# NEVER commit the actual .env file with real secrets!

# API Configuration (Required for production)
EXPO_PUBLIC_API_BASE_URL=https://your-production-api.com

# Firebase Configuration (Required)
# Get these from your Firebase Project Settings > General > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Environment Settings
EXPO_PUBLIC_ENVIRONMENT=development

# Development Only (uncomment for local testing)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.40:8000

# === SECURITY NOTES ===
# 1. Never commit real API keys or secrets
# 2. Use different keys for development and production
# 3. Rotate keys regularly
# 4. Use environment-specific .env files
# 5. Add .env to .gitignore (already done)

# === HOW TO GET FIREBASE KEYS ===
# 1. Go to https://console.firebase.google.com
# 2. Select your project or create a new one
# 3. Go to Project Settings > General > Your apps
# 4. Add a new Web app
# 5. Copy the firebaseConfig object values
# 6. Replace the placeholder values above
